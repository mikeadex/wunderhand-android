<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application>
        <!-- The debug build only: a push, pretended, so a notification can be seen and tapped
             with no Firebase project and no chairtime change. Guarded by DUMP, which adb's
             shell holds and no app on the phone does:

               adb shell am broadcast -n com.wunderhand.app.debug/com.wunderhand.app.push.DebugPushReceiver \
                 -es title "New booking" -es body "Wren · Skin fade · today at 11:00" -es kind booked \
                 -es appointmentId <uuid> -es tenantId <uuid>

             It takes the same path a real message takes (AppContainer.received). -->
        <receiver
            android:name="com.wunderhand.app.push.DebugPushReceiver"
            android:exported="true"
            android:permission="android.permission.DUMP" />
    </application>
</manifest>
